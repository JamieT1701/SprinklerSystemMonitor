assert(pilot_depth < plate_t+post_h,"Pilot must remain blind");
module outline(){polygon(outline_points);}
module plate_profile(){
 difference(){outline();for(p=hole_points)translate(p)circle(d=3.4);}
}
module frame_profile(){
 difference(){
  outline();
  difference(){
   offset(delta=-frame_web)outline();
   // Keep reinforced mounting islands connected to perimeter.
   for(p=posts)translate(p)circle(d=15.5);
  }
 }
}
module post(x,y){
 translate([x,y,plate_t-0.01]){
  cylinder(h=post_base_h+0.01,d1=post_base_d,d2=post_d);
  cylinder(h=post_h+0.01,d=post_d);
 }
}
module pilot(x,y){
 ztop=plate_t+post_h;
 translate([x,y,ztop-pilot_depth])cylinder(h=pilot_depth+0.02,d=pilot_d);
 translate([x,y,ztop-0.4])cylinder(h=0.42,d1=pilot_d,d2=3.1);
}
module assembly(is_frame=false){
 difference(){
  union(){
   linear_extrude(height=plate_t)
    if(is_frame)frame_profile();else plate_profile();
   for(p=posts)post(p[0],p[1]);
  }
  for(p=posts)pilot(p[0],p[1]);
 }
}
if(part=="plate")assembly();
else if(part=="fit_frame")assembly(true);
else assert(false,"Unknown part");
